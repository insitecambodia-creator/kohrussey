# Public site URL (used for canonical links and the sitemap)
PUBLIC_SITE_URL=https://www.kohrusseyresort.com

# Keep false until the redesign is ready to go live (adds noindex + Disallow: /).
PUBLIC_ALLOW_INDEXING=false

# Optional. The enquiry forms (contact, weddings, corporate retreat) send each message to these, if set.
# Leave both empty and the forms open the visitor's email app instead.
# The Production URL of an n8n Webhook node (POST) that adds the lead to a Google Sheet.
PUBLIC_LEADS_WEBHOOK_URL=
# A free access key from web3forms.com, which emails the message to the resort.
PUBLIC_WEB3FORMS_KEY=
