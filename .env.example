# Public site URL (used for metadata and the sitemap)
NEXT_PUBLIC_SITE_URL=https://www.kohrusseyresort.com

# Full URL of the property's hosted Exely booking page. All "Book now" buttons link here.
# If unset, they fall back to the /contact page.
NEXT_PUBLIC_EXELY_BOOKING_URL=

# Keep false until the redesign is ready to go live (adds noindex + Disallow: /).
NEXT_PUBLIC_ALLOW_INDEXING=false
