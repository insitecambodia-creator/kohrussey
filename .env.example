# Public site URL (used for canonical links and the sitemap)
PUBLIC_SITE_URL=https://www.kohrusseyresort.com

# Keep false until the redesign is ready to go live (adds noindex + Disallow: /).
PUBLIC_ALLOW_INDEXING=false

# Optional. A free access key from web3forms.com makes the enquiry forms (contact, weddings, corporate retreat)
# email the resort directly. Leave it empty and the forms open the visitor's email app instead.
PUBLIC_WEB3FORMS_KEY=
