---
// A responsive photo: Astro makes several widths (never larger than the original) and the
// browser picks one using `sizes`. `priority` is for the one photo at the top of the page.
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The width the photo is shown at, for example `(min-width: 768px) 50vw, 100vw`. */
  sizes: string;
  class?: string;
  priority?: boolean;
  /** AVIF first (about a third smaller), with WebP for old browsers. Slower to build, so for the big hero photos only. */
  avif?: boolean;
  quality?: number;
}

const { src, alt, sizes, class: className, priority = false, avif = false, quality = 75 } = Astro.props;

const steps = [480, 640, 828, 1080, 1280, 1668, 2048, 2560];
const largest = Math.min(src.width, 2560);
const widths = [...steps.filter((w) => w < largest), largest];
---

{
  avif ? (
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      quality={quality}
      formats={["avif"]}
      fallbackFormat="webp"
      class={className}
      priority={priority}
    />
  ) : (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} quality={quality} class={className} priority={priority} />
  )
}
