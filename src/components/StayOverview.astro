---
// The overview at the top of the Villas page: it shows every type of stay at a glance and works as a
// sub-menu. The line of links under each title and every photo jump to that section further down.
import { stayOverview } from "../lib/stay-overview";
import Img from "./Img.astro";
import { prose } from "../lib/ui";

const delays = [undefined, 1, 2, 3] as const;
---

<section aria-label="Pavilions and villas at a glance" class="border-b border-ink/15 py-12 md:py-16">
  <div class="grid gap-14 md:grid-cols-2 md:gap-x-2">
    {
      stayOverview.map((group) => (
        <div>
          <h2 data-reveal="rise" class="text-3xl md:text-4xl">{group.title}</h2>
          <nav data-reveal="rise" data-delay="1" aria-label={group.title} class="mt-3 text-ink/75">
            {group.links.map((link, i) => (
              <>
                {i > 0 ? <span aria-hidden="true" class="mx-2 text-ink/40">&middot;</span> : null}
                <a href={link.href} class="hover:text-pool hover:underline underline-offset-4">{link.label}</a>
              </>
            ))}
          </nav>

          <div class="mt-5 grid aspect-[743/544] grid-cols-2 gap-2">
            {group.columns.map((column, c) => (
              <div class:list={["grid gap-2", column.rows]}>
                {column.tiles.map((tile, t) => (
                  <a
                    href={tile.href}
                    data-reveal="mask"
                    data-delay={delays[(c + t) % 4]}
                    class="group relative block overflow-hidden"
                  >
                    <Img
                      src={tile.photo.src}
                      alt=""
                      sizes={tile.sizes ?? "(min-width: 1152px) 380px, (min-width: 768px) 33vw, 60vw"}
                      class:list={["absolute inset-0 h-full w-full object-cover", tile.focus ?? tile.photo.focus]}
                    />
                    <span
                      aria-hidden="true"
                      class="absolute inset-0 bg-ink/0 transition-colors duration-300 group-hover:bg-ink/25"
                    />
                    <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 via-ink/40 to-transparent px-3 pb-2.5 pt-8 text-sm leading-tight text-salt">
                      <span class="block font-medium">{tile.label}</span>
                      {tile.note ? <span class="block text-xs text-salt/85">{tile.note}</span> : null}
                    </span>
                  </a>
                ))}
              </div>
            ))}
          </div>

          <p data-reveal="rise" class:list={["mt-6 text-ink/85", prose]}>{group.text}</p>
        </div>
      ))
    }
  </div>
</section>
