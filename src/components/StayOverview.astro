---
// The overview at the top of the Villas page: it shows every type of stay at a glance and works as a
// sub-menu. Each type is a column with a label and two photos, all of which jump to that section below.
import { stayOverview } from "../lib/stay-overview";
import Img from "./Img.astro";
import { prose } from "../lib/ui";

const delays = [undefined, 1, 2] as const;
---

<section aria-label="Pavilions and villas at a glance" class="border-b border-ink/15 py-12 md:py-16">
  <div class="grid gap-14 md:grid-cols-2 md:gap-x-10">
    {
      stayOverview.map((group) => (
        <div>
          <h2 data-reveal="rise" class="text-3xl md:text-4xl">{group.title}</h2>

          <div class="mt-5 grid grid-cols-3 gap-x-2 gap-y-2">
            {group.columns.map((column) => (
              <div data-reveal="rise" data-delay="1" class="min-h-11 pb-1 leading-snug">
                <a
                  href={column.href}
                  aria-label={column.name}
                  class="font-medium hover:text-pool hover:underline underline-offset-4"
                >
                  {column.label}
                </a>
                {column.more ? (
                  <p class="mt-0.5 text-xs text-ink/70">
                    {column.more.map((link, i) => (
                      <>
                        {i > 0 ? <span aria-hidden="true"> &middot; </span> : null}
                        <a href={link.href} class="hover:text-pool hover:underline underline-offset-4">
                          {link.label}
                        </a>
                      </>
                    ))}
                  </p>
                ) : null}
              </div>
            ))}

            {[0, 1].map((row) =>
              group.columns.map((column, c) => {
                const tile = column.tiles[row];
                return (
                  <a
                    href={tile.href ?? column.href}
                    tabindex="-1"
                    aria-hidden="true"
                    data-reveal="mask"
                    data-delay={delays[c]}
                    class="group relative block aspect-[6/7] overflow-hidden"
                  >
                    <Img
                      src={tile.photo.src}
                      alt=""
                      sizes="(min-width: 1152px) 360px, (min-width: 768px) 22vw, 40vw"
                      class:list={["absolute inset-0 h-full w-full object-cover", tile.focus ?? tile.photo.focus]}
                    />
                    <span
                      aria-hidden="true"
                      class="absolute inset-0 bg-ink/0 transition-colors duration-300 group-hover:bg-ink/25"
                    />
                  </a>
                );
              }),
            )}
          </div>

          <p data-reveal="rise" class:list={["mt-6 text-ink/85", prose]}>{group.text}</p>
        </div>
      ))
    }
  </div>
</section>
