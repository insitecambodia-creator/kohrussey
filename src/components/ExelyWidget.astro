---
// Mounts an Exely booking-engine widget into a container, using the same loader the current
// WordPress site uses: https://<host>/integration/loader.js, tried against each host in turn
// until one loads. The script below runs once per page and mounts every widget on it.
interface Props {
  widget: "booking-form" | "search-form";
  containerId: string;
  class?: string;
  /**
   * Wait for the visitor's first mouse move, scroll, tap or key press before loading Exely, so the
   * page's own content gets the browser first. Exely's loader is heavy and blocks the main thread.
   */
  defer?: boolean;
}

const { widget, containerId, class: className, defer = false } = Astro.props;
---

<div
  id={containerId}
  class={className}
  data-exely-widget={widget}
  data-exely-defer={defer ? "" : undefined}
>
</div>

<script>
  import { site } from "../lib/site";

  type ExelyCommand = [string, ...unknown[]];
  type ExelyWindow = Window & {
    bookingengine?: {
      integration?: { __cq?: ExelyCommand[]; __loader?: boolean; loaded?: boolean };
    };
  };

  const w = window as ExelyWindow;
  const containers = document.querySelectorAll<HTMLElement>("[data-exely-widget]");

  const start = () => {
    const { contextId, hosts, language } = site.exely;

    // The loader reads this command queue when it starts.
    w.bookingengine = {
      integration: {
        __cq: [
          ["setContext", contextId, language],
          ...Array.from(containers, (el): ExelyCommand => ["embed", el.dataset.exelyWidget, { container: el.id }]),
        ],
        __loader: true,
      },
    };

    const tryHost = (index: number) => {
      if (index >= hosts.length) return;
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://${hosts[index]}/integration/loader.js`;
      const next = () => {
        if (w.bookingengine?.integration?.loaded) return;
        script.remove();
        tryHost(index + 1);
      };
      script.onload = next;
      script.onerror = next;
      document.head.appendChild(script);
    };
    tryHost(0);
  };

  if (containers.length) {
    if (!Array.from(containers).every((el) => el.hasAttribute("data-exely-defer"))) {
      start();
    } else {
      // Deferred: load on the first sign of a visitor (a mouse move, scroll, tap or key press).
      const triggers = ["pointerdown", "pointermove", "keydown", "scroll", "touchstart"] as const;
      const go = () => {
        triggers.forEach((name) => window.removeEventListener(name, go));
        start();
      };
      triggers.forEach((name) => window.addEventListener(name, go, { passive: true }));
    }
  }
</script>
