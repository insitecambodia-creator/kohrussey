---
// A muted, looping YouTube video behind the hero text.
//
// - It only loads once the page has finished loading, so the hero photo stays the first thing
//   painted, and never for visitors who prefer reduced motion or have Save-Data on.
// - The photo underneath stays visible until YouTube reports that playback has started, so a
//   blocked, private or non-embeddable video never shows YouTube's error screen.
// - It pauses while the hero is scrolled out of view.
// - It uses youtube-nocookie.com so YouTube sets no cookies until the visitor interacts.
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;
---

<div
  aria-hidden="true"
  data-hero-video={videoId}
  class="hero-video pointer-events-none absolute inset-0 -z-[15] overflow-hidden opacity-0 transition-opacity duration-[1600ms] data-[playing]:opacity-100"
>
</div>

<script>
  const ORIGIN = "https://www.youtube-nocookie.com";

  const root = document.querySelector<HTMLElement>("[data-hero-video]");
  const videoId = root?.dataset.heroVideo;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const skip = window.matchMedia("(prefers-reduced-motion: reduce)").matches || connection?.saveData;

  if (root && videoId && !skip) {
    const params = new URLSearchParams({
      autoplay: "1",
      mute: "1",
      controls: "0",
      loop: "1",
      playlist: videoId, // YouTube only loops a single video when it is also the playlist
      playsinline: "1",
      modestbranding: "1",
      rel: "0",
      iv_load_policy: "3",
      disablekb: "1",
      fs: "0",
      enablejsapi: "1",
      origin: window.location.origin,
    });

    const start = () => {
      const frame = document.createElement("iframe");
      frame.src = `${ORIGIN}/embed/${videoId}?${params}`;
      frame.title = "Background video of Koh Russey Resort";
      frame.tabIndex = -1;
      frame.allow = "autoplay; encrypted-media";
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.className = "border-0";

      const send = (message: object) => frame.contentWindow?.postMessage(JSON.stringify(message), ORIGIN);

      const onMessage = (event: MessageEvent) => {
        if (event.source !== frame.contentWindow || event.origin !== ORIGIN) return;
        let data: { event?: string; info?: unknown } | null = null;
        try {
          data = typeof event.data === "string" ? JSON.parse(event.data) : event.data;
        } catch {
          return;
        }
        const info = data?.info as { playerState?: number } | number | undefined;
        const state = data?.event === "onStateChange" ? info : typeof info === "object" ? info?.playerState : undefined;
        if (state === 1) root.setAttribute("data-playing", "");
      };

      // Ask the player to report its state; it replies to the handler above.
      frame.addEventListener("load", () => {
        send({ event: "listening", id: 1, channel: "widget" });
        send({ event: "command", func: "addEventListener", args: ["onStateChange"], id: 1, channel: "widget" });
      });
      window.addEventListener("message", onMessage);

      new IntersectionObserver(([entry]) => {
        send({ event: "command", func: entry.isIntersecting ? "playVideo" : "pauseVideo", args: [] });
      }).observe(root);

      root.appendChild(frame);
    };

    if (document.readyState === "complete") window.setTimeout(start, 0);
    else window.addEventListener("load", start, { once: true });
  }
</script>
