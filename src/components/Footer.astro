---
import { getPosts } from "../lib/blog";
import { ui, type Locale } from "../lib/i18n";
import { nav, secondaryNav, site, telLink, whatsappLink } from "../lib/site";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = ui[lang];

const social = [
  { label: "Facebook", href: site.social.facebook },
  { label: "Instagram", href: site.social.instagram },
  { label: "TikTok", href: site.social.tiktok },
];

// The Blog link appears once there is a published post.
const blogLinks = (await getPosts()).length > 0 ? [{ label: "Blog", href: "/blog/" }] : [];
const footerLinks = t.nav ?? [...secondaryNav, ...blogLinks, ...nav];

const item = "text-salt/80 hover:text-salt hover:underline underline-offset-4";
const c = site.contact;
---

<footer class="mt-24 bg-ink text-salt">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-[1.2fr_1fr_1.2fr]">
    <div>
      <p class="font-display text-2xl font-medium">{site.name}</p>
      <p class="mt-2 text-salt/80">{t.tagline}</p>
      <ul class="mt-5 flex gap-5 text-sm">
        {
          social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class={item}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm md:grid-cols-1">
      {
        footerLinks.map((n) => (
          <a href={n.href} class={item}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <address class="space-y-3 text-sm not-italic text-salt/80">
      <p>{c.resortAddress}</p>
      <p><a href={`mailto:${c.email}`} class={item}>{c.email}</a></p>
      <p><a href={telLink()} class={item}>{c.phone}</a></p>
      <p><a href={whatsappLink(t.whatsappMessage)} target="_blank" rel="noopener noreferrer" class={item}>{t.whatsapp}</a></p>
    </address>
  </div>
  <div class="border-t border-salt/15 py-5 text-center text-xs text-salt/60">
    {t.copyright}
  </div>
</footer>
