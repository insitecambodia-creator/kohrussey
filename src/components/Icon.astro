---
// An icon from the small set in lib/icons.ts, drawn in the current text colour. It is decoration: put the meaning in
// the text beside it.
import { icons, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-5" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["shrink-0", className]}
  set:html={icons[name]}
/>
