---
import type { MenuSection } from "../lib/menus";

interface Props {
  section: MenuSection;
}

const { section } = Astro.props;
---

<section data-reveal="rise" class="mb-10 break-inside-avoid">
  <h4 class="font-display text-2xl">{section.title}</h4>
  {section.note ? <p class="mt-2 text-ink/80">{section.note}</p> : null}
  {
    section.items ? (
      <ul class="mt-3 border-t border-ink/15">
        {section.items.map((item) => (
          <li class="border-b border-ink/15 py-3">
            <div class="flex items-baseline justify-between gap-6">
              <span class="font-medium">{item.name}</span>
              <span class="tabular-nums">{item.price}</span>
            </div>
            {item.details?.map((line) => (
              <p class="mt-1 max-w-[56ch] text-sm text-ink/75">{line}</p>
            ))}
          </li>
        ))}
      </ul>
    ) : null
  }
</section>
