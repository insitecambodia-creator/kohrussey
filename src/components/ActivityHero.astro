---
// The top of an activity page: a photo with the title over it, and a link back to all activities.
import type { ImageMetadata } from "astro";
import Img from "./Img.astro";

interface Props {
  title: string;
  /** One or two short lines under the title. */
  lines?: string[];
  photo: { src: ImageMetadata; alt: string };
  /** Where the photo is cropped (a Tailwind object-position class). */
  focus?: string;
}

const { title, lines = [], photo, focus = "object-[50%_50%]" } = Astro.props;
---

<section class="relative isolate flex min-h-[60svh] items-end overflow-hidden bg-ink text-salt">
  <Img
    src={photo.src}
    alt={photo.alt}
    sizes="100vw"
    priority
    avif
    quality={55}
    class:list={["hero-settle absolute inset-0 -z-20 h-full w-full object-cover", focus]}
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/95 via-ink/55 to-ink/30"></div>
  <div class="mx-auto w-full max-w-6xl px-4 pb-12 pt-32 md:pb-16">
    <a
      href="/activities/"
      class="hero-rise text-sm font-medium uppercase tracking-[0.18em] text-salt underline-offset-4 hover:underline"
      style="--d: 0.3s">Activities</a
    >
    <h1 class="hero-rise mt-4 max-w-[20ch] text-4xl sm:text-6xl md:text-7xl md:font-normal" style="--d: 0.6s">{title}</h1>
    {
      lines.map((line, i) => (
        <p class="hero-rise mt-4 max-w-[52ch] text-lg text-salt/90 md:text-xl" style={`--d: ${0.9 + i * 0.25}s`}>
          {line}
        </p>
      ))
    }
  </div>
</section>
