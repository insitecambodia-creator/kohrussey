---
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { locales, ui, type Locale } from "../lib/i18n";
import { images } from "../lib/images";
import { site } from "../lib/site";

interface Props {
  /** The page's own title; the site name is added after it unless the title already names the resort. Leave out on the homepage. */
  title?: string;
  description?: string;
  /** Keep this page out of search results even after launch (the booking page). */
  noindex?: boolean;
  /** The exact <title>, when it should not be built from `title` (blog posts with their own search title). */
  fullTitle?: string;
  /** The photo for social previews (1200x630 crop). Defaults to the homepage photo. */
  image?: ImageMetadata;
  /** `article` for blog posts. */
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Address of the original, when it is not this page. */
  canonicalUrl?: string;
  /** Structured data (schema.org) for search engines, one object or a list. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The language of the page; English unless said otherwise. */
  lang?: Locale;
  /** The same page in other languages (addresses), so search engines can link them together. */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = site.description,
  noindex = false,
  fullTitle: exactTitle,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  canonicalUrl,
  jsonLd,
  lang = "en",
  alternates,
} = Astro.props;

const fullTitle =
  exactTitle ??
  (title
    ? title.includes("Koh Russey") ? title : `${title} | ${site.name}`
    : `${site.name} | ${site.tagline}`);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const canonical = canonicalUrl ? new URL(canonicalUrl) : pageUrl;
const preview = await getImage({ src: image ?? images.poolMorning.src, width: 1200, height: 630, fit: "cover", format: "jpeg" });
const previewUrl = new URL(preview.src, Astro.site);

// Search engines stay out until the redesign is ready to go live.
const robots = !site.allowIndexing ? "noindex, nofollow" : noindex ? "noindex, follow" : "index, follow";
---

<!doctype html>
<html lang={locales[lang].htmlLang} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#132136" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {
      alternates && [
        ...(Object.entries(alternates) as [Locale, string][]).map(([code, path]) => (
          <link rel="alternate" hreflang={locales[code].hreflang} href={new URL(path, Astro.site)} />
        )),
        alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />,
      ]
    }

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locales[lang].ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={exactTitle ?? title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")} />
      )
    }

    {/* No favicon yet: an empty one stops the browser asking for /favicon.ico and logging a 404. */}
    <link rel="icon" href="data:," />

    {/* Preload only Regular and Medium: Light is for headings on inner pages. Preloading more slowed the first paint. */}
    <Font cssVariable="--font-wulkan" preload={[{ weight: 400, style: "normal" }, { weight: 500, style: "normal" }]} />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-salt focus:px-3 focus:py-2"
    >
      {ui[lang].skip}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollReveal />
  </body>
</html>
