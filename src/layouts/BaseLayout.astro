---
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { images } from "../lib/images";
import { site } from "../lib/site";

interface Props {
  /** The page's own title; the site name is added after it unless the title already names the resort. Leave out on the homepage. */
  title?: string;
  description?: string;
  /** Keep this page out of search results even after launch (the booking page). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const fullTitle = title
  ? title.includes("Koh Russey") ? title : `${title} | ${site.name}`
  : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = await getImage({ src: images.poolMorning.src, width: 1200, height: 630, format: "jpeg" });
const previewUrl = new URL(preview.src, Astro.site);

// Search engines stay out until the redesign is ready to go live.
const robots = !site.allowIndexing ? "noindex, nofollow" : noindex ? "noindex, follow" : "index, follow";
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d2623" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* No favicon yet: an empty one stops the browser asking for /favicon.ico and logging a 404. */}
    <link rel="icon" href="data:," />

    {/* Preload only Regular and Medium: Light is for headings on inner pages. Preloading more slowed the first paint. */}
    <Font cssVariable="--font-wulkan" preload={[{ weight: 400, style: "normal" }, { weight: 500, style: "normal" }]} />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-salt focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>
