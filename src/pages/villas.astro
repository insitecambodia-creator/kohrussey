---
import PageHeading from "../components/PageHeading.astro";
import RoomSection from "../components/RoomSection.astro";
import StayOverview from "../components/StayOverview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { accommodations, accommodationsClosing, accommodationsIntro } from "../lib/accommodations";
import { villaPhotos } from "../lib/stay-photos";
import { prose } from "../lib/ui";
---

<BaseLayout title={accommodationsIntro.metaTitle} description={accommodationsIntro.description}>
  <PageHeading title={accommodationsIntro.title} intro={accommodationsIntro.kicker} />
  <div class="mx-auto max-w-6xl px-4">
    <StayOverview />
    {
      accommodations.map((a) => (
        <>
          {/* Anchor for the homepage's "Beachfront Villas" link; outside the row so it takes no grid cell. */}
          {a.slug === "1-bedroom-beach-pool-villa" ? <span id="beachfront-villas" class="block scroll-mt-24" /> : null}
          <RoomSection room={a} photos={villaPhotos[a.slug] ?? []} />
        </>
      ))
    }

    <section class="grid gap-6 py-16 md:grid-cols-12 md:gap-10">
      <div data-reveal="rise" class:list={["space-y-4 text-ink/85 md:col-span-8 md:col-start-5", prose]}>
        {accommodationsClosing.map((p) => <p>{p}</p>)}
      </div>
    </section>
  </div>
</BaseLayout>
