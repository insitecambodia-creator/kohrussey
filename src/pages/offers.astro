---
import BookButton from "../components/BookButton.astro";
import PageHeading from "../components/PageHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { allInclusive } from "../lib/content";
import { prose } from "../lib/ui";
---

<BaseLayout title="Promotions & Special Offers" description="The All-Inclusive Villa Experience at Koh Russey Resort.">
  <PageHeading title="Promotions & Special Offers" />
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-12">
    <h2 data-reveal="slide" class="text-3xl md:col-span-5">{allInclusive.title}</h2>
    <div class="md:col-span-7">
      <p data-reveal="rise" data-delay="1" class:list={["text-ink/85", prose]}>{allInclusive.body}</p>
      <div data-reveal="rise" data-delay="2" class="mt-8">
        <BookButton>Book the all-inclusive package</BookButton>
      </div>
    </div>
  </div>
</BaseLayout>
