---
import EnquiryForm from "../components/EnquiryForm.astro";
import Icon from "../components/Icon.astro";
import PageHeading from "../components/PageHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactPage as page, promotionsPage } from "../lib/content";
import { site, telLink, whatsappLink } from "../lib/site";
import { button, link } from "../lib/ui";

const c = site.contact;
const row = "flex gap-4 py-4";
---

<BaseLayout title={page.metaTitle} description={page.description}>
  <PageHeading title={page.title} intro={page.tagline} />
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-14 md:grid-cols-2 md:gap-16">
    <section class="min-w-0">
      <ul data-reveal-group class="divide-y divide-ink/15 border-y border-ink/15">
        <li class={row}>
          <Icon name="phone" class="mt-1 size-5 text-pool" />
          <a href={telLink()} class="font-display text-2xl">{c.phone}</a>
        </li>
        <li class={row}>
          <Icon name="map-pin" class="mt-1 size-5 text-pool" />
          <address class="not-italic text-ink/85">
            {page.address}
            <span class="mt-2 block text-sm">
              <a href={c.mapUrl} target="_blank" rel="noopener noreferrer" class={link}>Open in Google Maps</a>
            </span>
          </address>
        </li>
        <li class={row}>
          <Icon name="mail" class="mt-1 size-5 text-pool" />
          <div class="min-w-0">
            <a href={`mailto:${c.email}`} class="break-words font-display text-xl sm:text-2xl">{c.email}</a>
            <div class="mt-3">
              <a href={`mailto:${c.email}`} class={button.dark}>{page.writeLabel}</a>
            </div>
          </div>
        </li>
        <li class={row}>
          <Icon name="message-circle" class="mt-1 size-5 text-pool" />
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class={link}>{promotionsPage.whatsappLabel}</a>
        </li>
        <li class={row}>
          <Icon name="send" class="mt-1 size-5 text-pool" />
          <a href={c.telegram} target="_blank" rel="noopener noreferrer" class={link}>{promotionsPage.telegramLabel}</a>
        </li>
      </ul>
      <p data-reveal="rise" class="mt-8 text-ink/85">
        <strong class="font-medium">{c.loungeName}</strong>
        <br />
        {c.loungeAddress}
      </p>
    </section>

    <section class="min-w-0">
      <h2 class="sr-only">Contact form</h2>
      <EnquiryForm
        id="contact-form"
        subject={page.form.subject}
        fields={[
          { type: "name", label: "Name *" },
          { type: "tel", label: "Phone *", name: "phone", required: true, placeholder: "Phone / Telegram" },
          { type: "email", label: "Email *", name: "email", required: true },
          { type: "textarea", label: "Comments", name: "comments", placeholder: "Comments or enquiry" },
        ]}
      />
    </section>
  </div>
</BaseLayout>
