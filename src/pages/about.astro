---
import PageHeading from "../components/PageHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { introLead, introRest, location } from "../lib/content";
import { prose } from "../lib/ui";
---

<BaseLayout title="About us" description="Koh Russey Resort is a luxury private island resort in Cambodia.">
  <PageHeading title="About us" intro={introLead} />
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-12">
    <div data-reveal="rise" class:list={["space-y-6 text-ink/85 md:col-span-7", prose]}>
      <p>{introRest}</p>
    </div>
    <div data-reveal="rise" data-delay="1" class="md:col-span-5">
      <h2 class="text-2xl">{location.title}</h2>
      <p class="mt-3 text-ink/85">{location.body}</p>
    </div>
  </div>
</BaseLayout>
