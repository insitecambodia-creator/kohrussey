---
import Img from "../../components/Img.astro";
import PageHeading from "../../components/PageHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postUrl } from "../../lib/blog";
import { site } from "../../lib/site";

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description={`News, travel tips and stories from ${site.name}, a private island resort in Cambodia.`}
  noindex={posts.length === 0}
>
  <PageHeading title="Blog" />
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    {
      posts.length === 0 ? (
        <p class="text-ink/80">No articles yet.</p>
      ) : (
        <ul data-reveal-group class="border-t border-ink/15">
          {posts.map((post) => (
            <li class="border-b border-ink/15">
              <a href={postUrl(post)} class="group grid gap-5 py-8 md:grid-cols-12 md:items-center md:gap-8">
                {post.data.cover ? (
                  <Img
                    src={post.data.cover}
                    alt={post.data.coverAlt ?? ""}
                    sizes="(min-width: 1152px) 360px, (min-width: 768px) 33vw, 100vw"
                    class="aspect-[3/2] w-full object-cover md:col-span-4"
                  />
                ) : null}
                <div class:list={["min-w-0", post.data.cover ? "md:col-span-8" : "md:col-span-12"]}>
                  <p class="text-sm text-ink/70">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    {post.data.tags.length > 0 ? <span> · {post.data.tags.join(", ")}</span> : null}
                  </p>
                  <h2 class="mt-2 text-2xl group-hover:underline decoration-ink/30 underline-offset-4 md:text-3xl">{post.data.title}</h2>
                  <p class="mt-3 max-w-[62ch] text-ink/80">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
