---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import BookButton from "../../components/BookButton.astro";
import Img from "../../components/Img.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postUrl, readingMinutes, type Post } from "../../lib/blog";
import { site } from "../../lib/site";
import { link } from "../../lib/ui";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    // Related posts share a tag; if none do, the neighbours in date order stand in.
    const related = posts
      .filter((p) => p.id !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)))
      .slice(0, 3);
    return {
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1], related },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
}

const { post, newer, older, related } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const origin = new URL("/", Astro.site);
const url = new URL(postUrl(post), Astro.site);
const social = data.cover ? await getImage({ src: data.cover, width: 1200, height: 630, fit: "cover", format: "jpeg" }) : undefined;

const publisher = { "@type": "Organization", name: site.name, url: origin.href };
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    ...(social ? { image: [new URL(social.src, Astro.site).href] } : {}),
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    mainEntityOfPage: url.href,
    author: publisher,
    publisher,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
      { "@type": "ListItem", position: 3, name: data.title, item: url.href },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  fullTitle={data.seoTitle}
  description={data.description}
  image={data.cover}
  type="article"
  publishedTime={data.date}
  modifiedTime={data.updated ?? data.date}
  canonicalUrl={data.canonical}
  noindex={data.noindex}
  jsonLd={jsonLd}
>
  <article>
    <header class="mx-auto max-w-6xl border-b border-ink/15 px-4 pb-10 pt-16 md:pt-24">
      <nav aria-label="Breadcrumb" class="text-sm text-ink/70">
        <a href="/blog/" class={link}>Blog</a>
      </nav>
      <h1 data-reveal="rise" class="mt-4 max-w-[22ch] text-4xl md:text-6xl">{data.title}</h1>
      <p data-reveal="rise" data-delay="1" class="mt-5 max-w-[60ch] text-lg text-ink/80">{data.description}</p>
      <p class="mt-6 text-sm text-ink/70">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {
          data.updated ? (
            <span>
              {" "}
              · Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
            </span>
          ) : null
        }
        <span> · {readingMinutes(post)} min read</span>
        {data.tags.length > 0 ? <span> · {data.tags.join(", ")}</span> : null}
      </p>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      {
        data.cover ? (
          <Img
            src={data.cover}
            alt={data.coverAlt ?? ""}
            sizes="(min-width: 1152px) 1120px, 100vw"
            priority
            class="mb-12 aspect-[16/9] w-full object-cover md:mb-16 md:aspect-[21/9]"
          />
        ) : null
      }
      <div class="post-body">
        <Content />
      </div>

      <aside class="mt-16 max-w-[68ch] border-t border-ink/15 pt-8">
        <p class="font-display text-2xl">Plan your stay at {site.name}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <BookButton>Check availability</BookButton>
          <a href="/villas/" class={link}>See the villas</a>
          <a href="/getting-here/" class={link}>How to get here</a>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 ? (
      <section aria-labelledby="more" class="mx-auto max-w-6xl px-4 pb-4">
        <h2 id="more" class="border-t border-ink/15 pt-8 text-2xl">More from the blog</h2>
        <ul class="mt-4">
          {related.map((p) => (
            <li class="border-b border-ink/15">
              <a href={postUrl(p)} class="block py-4 hover:underline underline-offset-4">
                <span class="text-sm text-ink/70">{formatDate(p.data.date)}</span>
                <span class="mt-1 block font-display text-xl">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    newer || older ? (
      <nav aria-label="Other posts" class="mx-auto mt-10 grid max-w-6xl gap-6 px-4 text-sm md:grid-cols-2">
        <div>
          {newer ? (
            <a href={postUrl(newer)} class="block hover:underline underline-offset-4">
              <span class="text-ink/70">Newer</span>
              <span class="mt-1 block font-display text-lg">{newer.data.title}</span>
            </a>
          ) : null}
        </div>
        <div class="md:text-right">
          {older ? (
            <a href={postUrl(older)} class="block hover:underline underline-offset-4">
              <span class="text-ink/70">Older</span>
              <span class="mt-1 block font-display text-lg">{older.data.title}</span>
            </a>
          ) : null}
        </div>
      </nav>
    ) : null
  }
</BaseLayout>
