---
import AudioPlayer from "../components/AudioPlayer.astro";
import BookButton from "../components/BookButton.astro";
import ExelyWidget from "../components/ExelyWidget.astro";
import HeroVideo from "../components/HeroVideo.astro";
import Img from "../components/Img.astro";
import ParallaxFrame from "../components/ParallaxFrame.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { welcomeAudio } from "../lib/audio";
import { homeAlternates } from "../lib/i18n";
import { homeSchema } from "../lib/structured-data";
import { allInclusive, introLead, introRest, location, reviews, spa, villas } from "../lib/content";
import { images } from "../lib/images";
import { site, telLink, whatsappLink } from "../lib/site";
import { photos } from "../lib/stay-photos";
import { link, prose } from "../lib/ui";

const pillars = [
  {
    href: "/villas/",
    title: "Stay",
    body: "Each villa has a private pool, with the beach just steps away.",
    cta: "See the villas",
  },
  {
    href: "/restaurants/",
    title: "Savour",
    body: "Authentic Khmer flavors and international cuisine, by the sea.",
    cta: "See the restaurants",
  },
  {
    href: "/activities/",
    title: "Explore",
    body: "Snorkeling, paddleboarding, cultural tours and spa rituals.",
    cta: "See the activities",
  },
];

const [featuredReview, ...otherReviews] = reviews;
const jsonLd = await homeSchema(Astro.site, site.description, "en");
---

<BaseLayout alternates={homeAlternates} jsonLd={jsonLd}>
  <section class="relative isolate flex min-h-[86svh] items-end overflow-hidden bg-ink text-salt">
    <Img
      src={images.poolMorning.src}
      alt={images.poolMorning.alt}
      sizes="100vw"
      priority
      avif
      quality={55}
      class="hero-settle absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <HeroVideo videoId={site.heroVideo.youtubeId} />
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-ink/95 via-ink/60 to-transparent"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-14 pt-40 md:pb-20">
      <h1 class="hero-rise max-w-[14ch] text-5xl sm:text-7xl md:text-8xl md:font-normal" style="--d: 0.3s">
        {site.tagline}
      </h1>
      <p class="hero-rise mt-6 max-w-[46ch] text-lg text-salt/90" style="--d: 0.7s">
        {introLead}
      </p>
      <div class="hero-rise mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" style="--d: 1s">
        <BookButton on="dark">Check availability</BookButton>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-salt/50 hover:decoration-salt"
        >Message us on WhatsApp</a>
        <a href={telLink()} class="underline underline-offset-4 decoration-salt/50 hover:decoration-salt">{site.contact.phone}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="availability" class="border-b border-ink/15 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <h2 id="availability" class="text-xl font-medium">Check availability</h2>
      <ExelyWidget widget="search-form" containerId="be-search-form" class="mt-4 min-h-24" defer />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
    <div class="grid lg:grid-cols-12">
      <Photo
        image={photos.kohRusseyIsland}
        natural
        sizes="(min-width: 1152px) 560px, (min-width: 1024px) 50vw, 100vw"
        class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:self-start"
      />
      <div
        data-reveal="slide-right"
        data-delay="2"
        class="relative z-10 mx-4 -mt-10 bg-white p-7 shadow-[0_22px_44px_-18px_rgb(19_33_54/0.3)] lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:mx-0 lg:mt-12 lg:self-start lg:p-9"
      >
        <p class="max-w-[42ch] font-display text-2xl leading-snug lg:text-3xl">
          {introRest}
        </p>
        <AudioPlayer {...welcomeAudio} class="mt-6 max-w-xl border-t border-ink/15 pt-5" />
      </div>
    </div>
  </section>

  <section class="bg-copper text-salt">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <div data-reveal-group class="grid gap-10 md:grid-cols-3">
        {
          pillars.map((p) => (
            <div>
              <h2 class="text-3xl">{p.title}</h2>
              <p class="mt-3 max-w-[32ch] text-salt">{p.body}</p>
              <a
                href={p.href}
                class="mt-4 inline-block font-medium text-salt underline underline-offset-4 decoration-salt/60 hover:decoration-salt"
                >{p.cta}</a
              >
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto mt-20 grid max-w-6xl gap-12 px-4 md:mt-24 md:grid-cols-12 md:items-center">
    <div class="md:col-span-5">
      <h2 data-reveal="rise" class="text-3xl md:text-5xl">{villas.title}</h2>
      <p data-reveal="rise" data-delay="1" class:list={["mt-5 text-ink/80", prose]}>
        {villas.body}
      </p>
      <ul data-reveal-group class="mt-8 border-t border-ink/15">
        {
          villas.types.map((v) => (
            <li class="border-b border-ink/15">
              <a href={`/villas/#${v.slug}`} class="block py-3 hover:text-pool hover:underline underline-offset-4">{v.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="grid grid-cols-12 gap-4 md:col-span-7">
      <Photo image={images.girlPool} sizes="(min-width: 768px) 30vw, 58vw" class="col-span-7 aspect-[4/5]" />
      <Photo
        image={images.oceanfrontDreams}
        sizes="(min-width: 768px) 22vw, 42vw"
        delay={2}
        class="col-span-5 mt-16 aspect-[4/5]"
      />
    </div>
  </section>

  <section class="mx-auto mt-28 grid max-w-6xl gap-12 px-4 md:grid-cols-2 md:items-center">
    <Photo
      image={images.massageBeach2}
      sizes="(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw"
      class="aspect-[4/5] md:aspect-[5/6]"
    />
    <div>
      <h2 data-reveal="rise" class="text-3xl md:text-4xl">{spa.title}</h2>
      <p data-reveal="rise" data-delay="1" class:list={["mt-5 text-ink/80", prose]}>
        {spa.body}
      </p>
      <div data-reveal="rise" data-delay="2">
        <a href="/spa/" class:list={[link, "mt-6 inline-block"]}>See the spa</a>
      </div>
    </div>
  </section>

  <section class="relative isolate mt-28 overflow-hidden bg-ink text-salt">
    <Img
      src={images.poolMorning.src}
      alt=""
      sizes="100vw"
      quality={55}
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_65%]"
    />
    <HeroVideo videoId={site.heroVideo.youtubeId} lazy />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-ink/70"></div>
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-20 md:grid-cols-12 md:items-end">
      <h2 data-reveal="slide" class="text-4xl md:col-span-5 md:text-5xl">{allInclusive.title}</h2>
      <div class="md:col-span-7">
        <p data-reveal="rise" data-delay="1" class:list={["text-salt", prose]}>
          {allInclusive.body}
        </p>
        <div data-reveal="rise" data-delay="2">
          <a href="/offers/" class="mt-8 inline-flex bg-accent px-6 py-3 text-sm font-medium text-ink hover:bg-white">Go for our all-inclusive package</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4">
    <figure data-reveal="rise">
      <blockquote class="max-w-[40ch] font-display text-3xl leading-snug md:text-4xl">
        &ldquo;{featuredReview.quote}&rdquo;
      </blockquote>
      <figcaption class="mt-6 text-sm text-ink/70">
        {featuredReview.author}, {featuredReview.title}
      </figcaption>
    </figure>
    <div data-reveal-group class="mt-14 grid gap-10 border-t border-ink/15 pt-8 md:grid-cols-2">
      {
        otherReviews.map((r) => (
          <figure>
            <blockquote class:list={["text-ink/85", prose]}>&ldquo;{r.quote}&rdquo;</blockquote>
            <figcaption class="mt-3 text-sm text-ink/70">
              {r.author}, {r.title}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-4">
    <ParallaxFrame class="aspect-[16/9] md:aspect-[21/8]">
      <Img
        src={images.mapResort.src}
        alt={images.mapResort.alt}
        sizes="(min-width: 1152px) 1120px, 100vw"
        class="h-full w-full object-cover"
      />
    </ParallaxFrame>
    <div class="mt-10 grid gap-6 md:grid-cols-12">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{location.title}</h2>
      <div class="md:col-span-7">
        <p data-reveal="rise" data-delay="1" class:list={["text-ink/80", prose]}>
          {location.body}
        </p>
        <div data-reveal="rise" data-delay="2">
          <a href="/getting-here/" class:list={[link, "mt-5 inline-block"]}>See shuttle times and how to get here</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
