---
import BookButton from "../../components/BookButton.astro";
import ExelyWidget from "../../components/ExelyWidget.astro";
import HeroVideo from "../../components/HeroVideo.astro";
import Img from "../../components/Img.astro";
import Photo from "../../components/Photo.astro";
import RichText from "../../components/RichText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeZh as t } from "../../lib/home-zh";
import { homeAlternates } from "../../lib/i18n";
import { images } from "../../lib/images";
import { site } from "../../lib/site";
import { photos } from "../../lib/stay-photos";
import { button, link, prose } from "../../lib/ui";

const mosaic = [
  photos.aerialDusk,
  images.beachAerialSunset,
  photos.beachVilla2Pool,
  images.girlPool,
  images.oceanfrontDreams,
  images.massageBeach2,
];
---

<BaseLayout lang="zh" title={t.metaTitle} description={t.description} alternates={homeAlternates}>
  <section class="relative isolate flex min-h-[86svh] items-end overflow-hidden bg-ink text-salt">
    <Img
      src={images.poolMorning.src}
      alt={images.poolMorning.alt}
      sizes="100vw"
      priority
      avif
      quality={55}
      class="hero-settle absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <HeroVideo videoId={site.heroVideo.youtubeId} />
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-ink/95 via-ink/60 to-transparent"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-14 pt-40 md:pb-20">
      <p class="hero-rise text-sm font-medium tracking-[0.12em] text-salt [text-shadow:0_1px_14px_rgb(0_0_0/0.6)]" style="--d: 0.2s">{t.hero.eyebrow}</p>
      <h1 class="hero-rise mt-4 max-w-[14ch] text-5xl sm:text-7xl md:text-8xl md:font-normal" style="--d: 0.4s">
        {t.hero.title.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
      </h1>
      <div class="hero-rise mt-6 max-w-[40em] space-y-2 text-lg text-salt/90" style="--d: 0.8s">
        {t.hero.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="hero-rise mt-8 flex flex-wrap items-center gap-3" style="--d: 1.1s">
        <BookButton on="dark">{t.hero.book}</BookButton>
        <a href="#reasons" class={button.outlineOnDark}>{t.hero.explore}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="availability" class="border-b border-ink/15 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <h2 id="availability" class="text-xl font-medium">{t.availability}</h2>
      <ExelyWidget widget="search-form" containerId="be-search-form" class="mt-4 min-h-24" defer />
    </div>
  </section>

  <section id="reasons" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 md:py-32">
    <p data-reveal="rise" class="text-sm font-medium tracking-[0.12em] text-pool">{t.why.eyebrow}</p>
    <h2 data-reveal="rise" data-delay="1" class="mt-4 text-3xl md:text-5xl">{t.why.title}</h2>
    <div data-reveal-group class="mt-12 grid gap-x-10 gap-y-10 border-t border-ink/15 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.why.items.map((item) => (
          <div>
            <h3 class="text-2xl">{item.title}</h3>
            <p class="mt-3 text-ink/85">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-ink/15">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h2 data-reveal="rise" class="text-3xl md:text-5xl">{t.spaces.title}</h2>

      <div class="mt-14 grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <Photo
          image={photos.oceanPavilionRoom}
          sizes="(min-width: 1152px) 600px, (min-width: 768px) 50vw, 100vw"
          class="aspect-[4/3] md:col-span-6"
        />
        <div class="md:col-span-6">
          <h3 data-reveal="rise" class="text-3xl">{t.spaces.pavilions.title}</h3>
          <p data-reveal="rise" data-delay="1" class="mt-4 text-ink/85">{t.spaces.pavilions.intro}</p>
          <ul data-reveal-group class="mt-6 border-t border-ink/15">
            {
              t.spaces.pavilions.items.map((item) => (
                <li class="border-b border-ink/15 py-4">
                  <span class="font-display text-xl font-medium">{item.name}</span>
                  <span class="mt-1 block text-ink/85">{item.text}</span>
                </li>
              ))
            }
          </ul>
          <div data-reveal="rise" class="mt-8">
            <a href="/villas/#garden-pavilion" class={button.outline}>{t.spaces.pavilions.cta}</a>
          </div>
        </div>
      </div>

      <div class="mt-20 grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-6 md:row-start-1">
          <h3 data-reveal="rise" class="text-3xl">{t.spaces.villas.title}</h3>
          <div class:list={["mt-4 space-y-3 text-ink/85", prose]}>
            {t.spaces.villas.lines.map((line) => <p data-reveal="rise"><RichText text={line} /></p>)}
          </div>
          <div data-reveal="rise" class="mt-8">
            <a href="/villas/#beachfront-villas" class={button.outline}>{t.spaces.villas.cta}</a>
          </div>
        </div>
        <Photo
          image={photos.beachVilla2Night}
          sizes="(min-width: 1152px) 600px, (min-width: 768px) 50vw, 100vw"
          class="aspect-[4/3] md:col-span-6 md:row-start-1"
        />
      </div>
    </div>
  </section>

  <section class="bg-pool text-salt">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-20 md:grid-cols-12 md:items-center">
      <h2 data-reveal="slide" class="text-4xl md:col-span-5 md:text-5xl">{t.slow.title}</h2>
      <div class="space-y-3 text-lg text-salt/90 md:col-span-7">
        {t.slow.lines.map((line, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}>{line}</p>)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {
        mosaic.map((p, i) => (
          <Photo
            image={p}
            sizes="(min-width: 1152px) 365px, (min-width: 768px) 33vw, 50vw"
            delay={(i % 3 === 0 ? undefined : (i % 3) as 1 | 2)}
            class="aspect-[4/3]"
          />
        ))
      }
    </div>
    <p class="mt-5"><a href="/gallery/" class={link}>图库</a></p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <section class="grid gap-8 border-t border-ink/15 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{t.dining.title}</h2>
      <div class="md:col-span-7">
        <div class="space-y-3 text-ink/85">
          {t.dining.lines.map((line, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}>{line}</p>)}
        </div>
        <div data-reveal="rise" class="mt-8">
          <a href="/restaurants/" class={button.outline}>{t.dining.cta}</a>
        </div>
      </div>
    </section>

    <section class="grid gap-8 border-t border-ink/15 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{t.spa.title}</h2>
      <div class="md:col-span-7">
        <div class="space-y-3 text-ink/85">
          {t.spa.lines.map((line, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}>{line}</p>)}
        </div>
        <div data-reveal="rise" class="mt-8">
          <a href="/spa/" class={button.outline}>{t.spa.cta}</a>
        </div>
      </div>
    </section>

    <section class="grid gap-8 border-t border-ink/15 py-16 md:grid-cols-12 md:py-20">
      <div class="md:col-span-5">
        <h2 data-reveal="rise" class="text-3xl md:text-4xl">{t.activities.title}</h2>
        <p data-reveal="rise" data-delay="1" class="mt-4 text-ink/85">{t.activities.lead}</p>
      </div>
      <ul data-reveal-group class="border-t border-ink/15 md:col-span-7">
        {
          t.activities.items.map((a) => (
            <li class="border-b border-ink/15 py-4">
              <a href={a.href} class="font-display text-xl font-medium hover:text-pool">{a.name}</a>
              <span class="mt-1 block text-ink/85">{a.text}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
