---
import ActivityHero from "../../components/ActivityHero.astro";
import MoreActivities from "../../components/MoreActivities.astro";
import Photo from "../../components/Photo.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { snorkelingPage as page } from "../../lib/activity-pages";
import { images } from "../../lib/images";
import { site } from "../../lib/site";
import { photos } from "../../lib/stay-photos";
import { button, prose } from "../../lib/ui";
---

<BaseLayout title={page.metaTitle} description={page.description} image={images.snorkelingAerial.src}>
  <ActivityHero title={page.title} lines={[page.lead, page.lead2]} photo={photos.aerialDusk} focus="object-[50%_55%]" />
  <div class="mx-auto max-w-6xl px-4">
    <section class="grid items-center gap-10 py-16 md:grid-cols-12 md:gap-12 md:py-20">
      <Photo
        image={images.snorkelingAerial}
        sizes="(min-width: 1152px) 480px, (min-width: 768px) 40vw, 100vw"
        class="aspect-[4/5] rounded-xl md:col-span-5"
      />
      <div class:list={["space-y-5 text-ink/85 md:col-span-7", prose]}>
        {page.body.map((p, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}>{p}</p>)}
        <div data-reveal="rise" data-delay="2" class="flex flex-wrap gap-3 pt-4">
          <a href={page.readMore.href} class={button.dark}>{page.readMore.label}</a>
          <a href={site.contact.telegram} target="_blank" rel="noopener noreferrer" class={button.outline}>{page.telegramLabel}</a>
        </div>
      </div>
    </section>

    <section class="grid gap-4 pb-16 sm:grid-cols-2 md:pb-20">
      {
        [images.snorkelingGear, images.snorkelingBay].map((p, i) => (
          <Photo
            image={p}
            sizes="(min-width: 1152px) 560px, (min-width: 640px) 50vw, 100vw"
            delay={i === 0 ? undefined : 2}
            class="aspect-[4/3] rounded-xl"
          />
        ))
      }
    </section>

    <MoreActivities current="/activities/snorkeling/" />
  </div>
</BaseLayout>
