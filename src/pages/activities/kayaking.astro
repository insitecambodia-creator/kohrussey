---
import ActivityHero from "../../components/ActivityHero.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import MoreActivities from "../../components/MoreActivities.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { kayakingPage as page } from "../../lib/activity-pages";
import { images } from "../../lib/images";
import { prose } from "../../lib/ui";
---

<BaseLayout title={page.metaTitle} description={page.description} image={images.beachAerialSunset.src}>
  <ActivityHero title={page.title} lines={[page.lead]} photo={images.beachAerialSunset} focus="object-[50%_60%]" />
  <div class="mx-auto max-w-6xl px-4">
    <section class="grid gap-8 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{page.heading}</h2>
      <div class:list={["space-y-5 text-ink/85 md:col-span-7", prose]}>
        {page.body.map((p, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}>{p}</p>)}
      </div>
    </section>

    <section class="grid gap-8 border-t border-ink/15 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="max-w-[22ch] text-2xl md:col-span-5 md:text-3xl">{page.form.heading}</h2>
      <div class="md:col-span-7 md:max-w-md">
        <EnquiryForm
          id="kayak-form"
          subject={page.form.subject}
          submitLabel={page.form.submit}
          fields={[{ type: "text", label: page.form.label, name: "name", required: true, placeholder: page.form.label }]}
        />
      </div>
    </section>

    <MoreActivities current="/activities/kayaking/" />
  </div>
</BaseLayout>
