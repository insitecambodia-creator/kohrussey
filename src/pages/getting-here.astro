---
import Img from "../components/Img.astro";
import PageHeading from "../components/PageHeading.astro";
import ParallaxFrame from "../components/ParallaxFrame.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { location, shuttles } from "../lib/content";
import { images } from "../lib/images";
import { site } from "../lib/site";
import { link } from "../lib/ui";

const cell = "border-b border-ink/15 py-3 pr-4 text-left align-top";
---

<BaseLayout
  title="Getting here"
  description="Shuttle schedules from Ream to Koh Russey Resort on Bamboo Island, Cambodia."
>
  <PageHeading title="Getting here" intro={location.body} />
  <div class="mx-auto max-w-6xl space-y-20 px-4 py-14">
    <ParallaxFrame class="aspect-[16/9] md:aspect-[21/8]">
      <Img
        src={images.mapResort.src}
        alt={images.mapResort.alt}
        sizes="(min-width: 1152px) 1120px, 100vw"
        class="h-full w-full object-cover"
      />
    </ParallaxFrame>

    <section class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 data-reveal="rise" class="text-3xl">Shuttle schedules</h2>
        <p data-reveal="rise" data-delay="1" class="mt-4 max-w-[32ch] text-ink/80">{shuttles.note}</p>
      </div>
      <div class="space-y-12 md:col-span-8">
        {
          shuttles.seasons.map((season) => (
            <table data-reveal="rise" class="w-full table-fixed text-sm sm:text-base">
              <caption class="pb-3 text-left font-display text-2xl font-medium">
                {season.name}
                <span class="ml-3 font-sans text-base text-ink/70">{season.dates}</span>
              </caption>
              <colgroup>
                <col class="w-[44%]" />
                <col class="w-[28%]" />
                <col class="w-[28%]" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col" class:list={[cell, "border-t border-ink/15 font-medium"]}>Days</th>
                  <th scope="col" class:list={[cell, "border-t border-ink/15 font-medium"]}>From Ream</th>
                  <th scope="col" class:list={[cell, "border-t border-ink/15 font-medium"]}>From the resort</th>
                </tr>
              </thead>
              <tbody>
                {season.groups.map((g) => (
                  <tr>
                    <th scope="row" class:list={[cell, "font-normal"]}>{g.label}</th>
                    <td class={cell}>{g.fromRream.join(", ")}</td>
                    <td class={cell}>{g.fromResort.join(", ")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ))
        }
      </div>
    </section>

    <section class="grid gap-8 md:grid-cols-12">
      <h2 data-reveal="rise" class="text-3xl md:col-span-4">Where to find us</h2>
      <div data-reveal="rise" data-delay="1" class="space-y-4 md:col-span-8">
        <p>
          <strong class="font-medium">{site.contact.loungeName}</strong>
          <br />
          {site.contact.loungeAddress}
        </p>
        <p>
          <strong class="font-medium">{site.name}</strong>
          <br />
          {site.contact.resortAddress}
        </p>
        <p><a href={site.contact.mapUrl} target="_blank" rel="noopener noreferrer" class={link}>Open in Google Maps</a></p>
      </div>
    </section>
  </div>
</BaseLayout>
