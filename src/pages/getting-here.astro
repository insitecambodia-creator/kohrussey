---
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import PageHeading from "../components/PageHeading.astro";
import ParallaxFrame from "../components/ParallaxFrame.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { gettingHerePage as page } from "../lib/getting-here";
import { images } from "../lib/images";
import { photos } from "../lib/stay-photos";
import { button, prose } from "../lib/ui";
---

<BaseLayout title={page.metaTitle} description={page.description}>
  <PageHeading title={page.title} intro={page.intro} />
  <div class="mx-auto max-w-6xl px-4">
    <div class="mt-12">
      <ParallaxFrame class="aspect-[16/9] md:aspect-[21/8]">
        <Img
          src={images.mapResort.src}
          alt={images.mapResort.alt}
          sizes="(min-width: 1152px) 1120px, 100vw"
          class="h-full w-full object-cover"
        />
      </ParallaxFrame>
    </div>

    <section class="grid gap-8 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{page.lounge.title}</h2>
      <div class="md:col-span-7">
        <p data-reveal="rise" data-delay="1" class="font-display text-2xl leading-snug">{page.lounge.lead}</p>
        <p data-reveal="rise" data-delay="2" class:list={["mt-5 text-ink/85", prose]}>{page.lounge.body}</p>
        <div data-reveal="rise" data-delay="2" class="mt-8">
          <a href={page.lounge.mapUrl} target="_blank" rel="noopener noreferrer" class={button.dark}>{page.lounge.mapLabel}</a>
        </div>
      </div>
    </section>

    <section class="grid gap-8 border-t border-ink/15 py-16 md:grid-cols-12 md:py-20">
      <h2 data-reveal="rise" class="text-3xl md:col-span-5 md:text-4xl">{page.schedules.title}</h2>
      <div class="md:col-span-7">
        <p data-reveal="rise" data-delay="1" class="flex items-center gap-3 text-lg">
          <Icon name="ship" class="size-6 text-pool" />
          {page.schedules.lead}
        </p>
        <ul data-reveal-group class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
          {
            page.schedules.times.map((t) => (
              <li class="flex items-center gap-3">
                <Icon name="clock" class="size-6 text-pool" />
                <span class="font-display text-4xl md:text-5xl">{t}</span>
              </li>
            ))
          }
        </ul>
        <p data-reveal="rise" class:list={["mt-8 text-ink/85", prose]}>{page.schedules.note}</p>
        <p data-reveal="rise" class:list={["mt-4 text-ink/85", prose]}>
          {page.schedules.notice.before}<strong class="font-medium">{page.schedules.notice.strong}</strong>{page.schedules.notice.after}
        </p>
      </div>
    </section>

    <section class="grid items-center gap-10 border-t border-ink/15 py-16 md:grid-cols-12 md:gap-12 md:py-24">
      <Photo
        image={photos.aerialDusk}
        sizes="(min-width: 1152px) 480px, (min-width: 768px) 40vw, 100vw"
        class="aspect-[4/3] md:col-span-5"
      />
      <div class="md:col-span-7">
        <h2 data-reveal="rise" class="text-3xl md:text-4xl">{page.helicopter.title}</h2>
        <p data-reveal="rise" data-delay="1" class:list={["mt-5 text-ink/85", prose]}>{page.helicopter.body}</p>
        <div data-reveal="rise" data-delay="2" class="mt-8">
          <a href={page.helicopter.href} target="_blank" rel="noopener noreferrer" class={button.dark}>{page.helicopter.label}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
