---
import ExelyWidget from "../../components/ExelyWidget.astro";
import HeroVideo from "../../components/HeroVideo.astro";
import Img from "../../components/Img.astro";
import Photo from "../../components/Photo.astro";
import RichText from "../../components/RichText.astro";
import BookButton from "../../components/BookButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeFr as t } from "../../lib/home-fr";
import { homeAlternates } from "../../lib/i18n";
import { images } from "../../lib/images";
import { site, whatsappLink } from "../../lib/site";
import { photos } from "../../lib/stay-photos";
import { button, prose } from "../../lib/ui";
---

<BaseLayout lang="fr" title={t.metaTitle} description={t.description} alternates={homeAlternates}>
  <section class="relative isolate flex min-h-[86svh] items-end overflow-hidden bg-ink text-salt">
    <Img
      src={images.poolMorning.src}
      alt={images.poolMorning.alt}
      sizes="100vw"
      priority
      avif
      quality={55}
      class="hero-settle absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <HeroVideo videoId={site.heroVideo.youtubeId} />
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-ink/95 via-ink/60 to-transparent"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-14 pt-40 md:pb-20">
      <p class="hero-rise text-sm font-medium uppercase tracking-[0.18em] text-salt [text-shadow:0_1px_14px_rgb(0_0_0/0.6)]" style="--d: 0.2s">{t.hero.eyebrow}</p>
      <h1 class="hero-rise mt-4 max-w-[16ch] text-5xl sm:text-7xl md:text-8xl md:font-normal" style="--d: 0.4s">
        {t.hero.title.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
      </h1>
      <p class="hero-rise mt-6 max-w-[58ch] text-lg text-salt/90" style="--d: 0.8s"><RichText text={t.hero.body} /></p>
      <div class="hero-rise mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" style="--d: 1.1s">
        <BookButton on="dark">{t.availability}</BookButton>
        <a
          href={whatsappLink("Bonjour ! J’aimerais avoir des informations sur un séjour au Koh Russey Resort.")}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-salt/50 hover:decoration-salt">{t.hero.whatsapp}</a
        >
        <a href={site.contact.telegram} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-salt/50 hover:decoration-salt">{t.hero.telegram}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="availability" class="border-b border-ink/15 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <h2 id="availability" class="text-xl font-medium">{t.availability}</h2>
      <ExelyWidget widget="search-form" containerId="be-search-form" class="mt-4 min-h-24" defer />
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-24 md:grid-cols-12 md:py-32">
    <div class="md:col-span-5">
      <p data-reveal="rise" class="text-sm font-medium uppercase tracking-[0.16em] text-pool">{t.facet.eyebrow}</p>
      <h2 data-reveal="rise" data-delay="1" class="mt-4 text-3xl md:text-5xl">{t.facet.title}</h2>
    </div>
    <div class:list={["space-y-5 text-ink/85 md:col-span-7", prose]}>
      {t.facet.paragraphs.map((p, i) => <p data-reveal="rise" data-delay={i === 0 ? undefined : 1}><RichText text={p} /></p>)}
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-ink text-salt">
    <Img
      src={images.horizonRestaurant.src}
      alt=""
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-ink/80"></div>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-12 md:py-28">
      <h2 data-reveal="slide" class="text-3xl md:col-span-4 md:text-5xl">{t.why.title}</h2>
      <div data-reveal-group class="grid gap-x-12 gap-y-10 md:col-span-8 md:grid-cols-2">
        {
          t.why.items.map((item) => (
            <div class="border-t border-salt/25 pt-5">
              <h3 class="text-2xl">{item.title}</h3>
              <p class="mt-3 text-salt/85"><RichText text={item.text} /></p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <section class="grid items-center gap-10 py-20 md:grid-cols-12 md:gap-12 md:py-28">
      <Photo
        image={photos.oceanPavilionRoom}
        sizes="(min-width: 1152px) 600px, (min-width: 768px) 50vw, 100vw"
        class="aspect-[4/3] md:col-span-6"
      />
      <div class="md:col-span-6">
        <h2 data-reveal="rise" class="text-3xl md:text-5xl">{t.pavilions.title}</h2>
        <p data-reveal="rise" data-delay="1" class:list={["mt-5 text-ink/85", prose]}><RichText text={t.pavilions.intro} /></p>
        <ul data-reveal-group class="mt-8 border-t border-ink/15">
          {
            t.pavilions.items.map((item) => (
              <li class="border-b border-ink/15 py-4">
                <span class="font-display text-xl font-medium">{item.name}</span>
                <span class="mt-1 block text-ink/85">{item.text}</span>
              </li>
            ))
          }
        </ul>
        <div data-reveal="rise" class="mt-8">
          <a href="/villas/#garden-pavilion" class={button.outline}>{t.pavilions.cta}</a>
        </div>
      </div>
    </section>

    <section class="grid items-center gap-10 border-t border-ink/15 py-20 md:grid-cols-12 md:gap-12 md:py-28">
      <div class="md:col-span-6 md:row-start-1">
        <h2 data-reveal="rise" class="text-3xl md:text-5xl">{t.villas.title}</h2>
        <div class:list={["mt-5 space-y-4 text-ink/85", prose]}>
          {t.villas.paragraphs.map((p) => <p data-reveal="rise"><RichText text={p} /></p>)}
        </div>
        <div data-reveal-group class="mt-8 space-y-2 border-l-2 border-accent pl-5 font-display text-xl md:text-2xl">
          {t.villas.day.map((line) => <p>{line}</p>)}
        </div>
        <p data-reveal="rise" class:list={["mt-5 text-ink/85", prose]}>{t.villas.closing}</p>
        <div data-reveal="rise" class="mt-8">
          <a href="/villas/#beachfront-villas" class={button.outline}>{t.villas.cta}</a>
        </div>
      </div>
      <Photo
        image={photos.beachVilla2Night}
        sizes="(min-width: 1152px) 600px, (min-width: 768px) 50vw, 100vw"
        class="aspect-[4/3] md:col-span-6 md:row-start-1"
      />
    </section>
  </div>
</BaseLayout>
