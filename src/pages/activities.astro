---
import Img from "../components/Img.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activitiesPage, activityBlocks, activityRates, featuredActivities } from "../lib/activities";
import { images } from "../lib/images";
import { photos } from "../lib/stay-photos";
import { link, prose } from "../lib/ui";

const { intro } = activitiesPage;

/** The photo shown with each activity row. Resort activities has its own set of three below. */
const rowPhotos: Record<string, (typeof images)[keyof typeof images]> = {
  spa: images.spaRoom,
  wellness: images.wellnessGym,
  "khmer-cooking-class": images.cookingClass,
  "pepper-delights": images.pepperTour,
};
const photoSizes = "(min-width: 1152px) 740px, (min-width: 768px) 66vw, 100vw";
---

<BaseLayout title={activitiesPage.metaTitle} description={activitiesPage.description}>
  <section class="relative isolate flex min-h-[58svh] items-end overflow-hidden bg-ink text-salt">
    <Img
      src={images.snorkelingAerial.src}
      alt={images.snorkelingAerial.alt}
      sizes="100vw"
      priority
      avif
      quality={55}
      class="hero-settle absolute inset-0 -z-20 h-full w-full object-cover object-[50%_62%]"
    />
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-ink/90 via-ink/50 to-transparent"
    >
    </div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-12 pt-32 md:pb-16">
      <h1 class="hero-rise max-w-[16ch] text-5xl sm:text-7xl md:font-normal" style="--d: 0.3s">
        {activitiesPage.title}
      </h1>
      <p class="hero-rise mt-5 max-w-[46ch] text-lg text-salt/90" style="--d: 0.7s">
        {activitiesPage.subtitle}
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <section class="grid gap-8 py-16 md:grid-cols-12 md:py-24">
      <h2 data-reveal="rise" class="text-3xl md:col-span-4">{intro.heading}</h2>
      <div class="md:col-span-8">
        <p data-reveal="rise" data-delay="1" class="max-w-[30ch] font-display text-2xl leading-snug md:text-4xl">
          {intro.lead}
        </p>
        <p data-reveal="rise" data-delay="2" class:list={["mt-6 text-ink/85", prose]}>
          {intro.invite}
        </p>
        <p data-reveal="rise" data-delay="2" class="mt-4 text-sm text-ink/70">
          {intro.note}
        </p>
      </div>
    </section>

    {
      activityBlocks.map((b) => (
        <article
          id={b.id}
          class="grid scroll-mt-24 gap-6 border-t border-ink/15 py-12 md:grid-cols-12 md:gap-10"
        >
          <div class="md:col-span-4">
            <h2 data-reveal="rise" class="text-3xl">{b.title}</h2>
            {b.meta?.map((m) => (
              <p data-reveal="rise" data-delay="1" class="mt-3 text-ink/80">
                {m}
              </p>
            ))}
          </div>
          <div class="md:col-span-8">
            <p data-reveal="rise" class:list={["text-ink/85", prose]}>
              {b.body}
            </p>
            {b.link ? (
              <div data-reveal="rise" data-delay="1" class="mt-5">
                <a href={b.link.href} class={link}>{b.link.label}</a>
              </div>
            ) : null}
            {rowPhotos[b.id] ? <Photo image={rowPhotos[b.id]} sizes={photoSizes} natural class="mt-8" /> : null}
            {b.id === "resort-activities" ? (
              <div class="mt-8 space-y-4">
                <Photo image={images.beachAerialSunset} sizes={photoSizes} natural />
                <div class="grid gap-4 sm:grid-cols-2">
                  <Photo
                    image={images.snorkelingBay}
                    sizes="(min-width: 1152px) 360px, (min-width: 640px) 40vw, 100vw"
                    class="aspect-[4/3]"
                  />
                  <Photo
                    image={images.snorkelingGear}
                    sizes="(min-width: 1152px) 360px, (min-width: 640px) 40vw, 100vw"
                    delay={2}
                    class="aspect-[4/3]"
                  />
                </div>
              </div>
            ) : null}
          </div>
        </article>
      ))
    }

    <section class="grid gap-6 border-t border-ink/15 py-12 md:grid-cols-12 md:gap-10">
      <h2 data-reveal="rise" class="text-3xl md:col-span-4">{activityRates.title}</h2>
      <p data-reveal="rise" data-delay="1" class:list={["text-ink/85 md:col-span-8", prose]}>
        {activityRates.body}
      </p>
    </section>

    <section class="grid gap-8 border-t border-ink/15 py-12 md:grid-cols-12 md:gap-10">
      <h2 data-reveal="rise" class="text-3xl md:col-span-4">Snorkeling guidelines</h2>
      <Photo
        image={images.snorkelingGuide}
        sizes="(min-width: 1152px) 740px, 100vw"
        natural
        class="border border-ink/15 md:col-span-8"
      />
    </section>

    <section class="border-t border-ink/15 py-16">
      <h2 data-reveal="rise" class="text-3xl md:text-5xl">{featuredActivities.title}</h2>
      <p data-reveal="rise" data-delay="1" class:list={["mt-5 text-ink/85", prose]}>
        {featuredActivities.intro}
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <Photo
          image={photos.beachDinnerCanopy}
          sizes="(min-width: 1152px) 560px, (min-width: 640px) 50vw, 100vw"
          class="aspect-[3/2]"
        />
        <Photo
          image={photos.beachDinnerTorches}
          sizes="(min-width: 1152px) 560px, (min-width: 640px) 50vw, 100vw"
          delay={2}
          class="aspect-[3/2]"
        />
      </div>
      <ul class="mt-10 grid gap-x-12 border-t border-ink/15 md:grid-cols-2">
        {
          featuredActivities.items.map((a) => (
            <li data-reveal="rise" class="border-b border-ink/15 py-6">
              <div class="flex items-baseline justify-between gap-6">
                <h3 class="font-display text-2xl font-medium">{a.title}</h3>
                <span class="whitespace-nowrap text-sm text-ink/70">{a.label}</span>
              </div>
              <p class="mt-2 max-w-[56ch] text-ink/85">{a.body}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
