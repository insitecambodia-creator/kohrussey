{
  // Cloudflare (Workers & Pages): serve the built site in dist/ as static files.
  "name": "kohrussey",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get dist/404.html (the site's own "Page not found" page).
    "not_found_handling": "404-page"
  }
}
